{
  "name": "jsdraw",
  "version": "0.1.0",
  "description": "",
  "main": "dist/js/app.js",
  "scripts": {
    "prebuild": "node bin/move-assets.js",
    "build": "npm run build:js && npm run build:sass && npm run build:pug",
    "build:js": "browserify src/js/index.js -o dist/js/app.js -t [ babelify --presets [ es2015 ] ]",
    "build:sass": "sass $(node bin/sass-paths.js) --quiet-deps --silence-deprecation=import src/sass/style.sass dist/css/style.css",
    "build:pug": "pug --out dist --pretty src/pug",
    "watch": "npm run watch:js & npm run watch:sass & npm run watch:pug & npm run livereload",
    "watch:js": "nodemon --watch 'src/js' --exec 'npm run build:js'",
    "watch:sass": "sass $(node bin/sass-paths.js) --quiet-deps --silence-deprecation=import --watch src/sass/style.sass:dist/css/style.css",
    "watch:pug": "npm run build:pug -- --watch",
    "livereload": "livereload dist",
    "start": "npm run build && (serve -l 3065 dist & npm run watch)"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "babel-preset-es2015": "^6.9.0",
    "babelify": "^7.3.0",
    "browserify": "^13.0.1",
    "fs-extra": "^0.30.0",
    "livereload": "^0.4.1",
    "nodemon": "^1.9.2",
    "pug-cli": "^1.0.0-alpha6",
    "sass": "^1.93.2",
    "serve": "^14.2.5"
  },
  "dependencies": {
    "font-awesome": "^4.6.3",
    "rx-lite": "^4.0.8"
  }
}
